      child: Row(
        children: [
          const Text(
            'Total Amount:',
            style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
          ),
          const Spacer(),
          Text(
            '₹${_transfer.totalAmount ?? '0.00'}',
